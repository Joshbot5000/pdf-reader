{
  "name": "hark",
  "version": "1.0.0",
  "description": "Hark: a private, fully local AI notetaker. Records, transcribes, identifies speakers, summarises and answers questions, all on your own machine.",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "Josh Lando",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.72.0",
    "node-llama-cpp": "^3.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "kokoro-js": "^1.2.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
